# Copie este arquivo para ".env" e preencha com seus próprios valores.

# Senha para entrar no painel de administração
ADMIN_PASSWORD=escolha-uma-senha-forte

# Frase secreta usada para proteger a sessão de login (qualquer texto longo e aleatório)
SESSION_SECRET=troque-por-um-texto-aleatorio-longo

# Porta em que o servidor vai rodar (opcional)
PORT=3000
